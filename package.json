{
  "name": "walmart-listing-browser",
  "productName": "Walmart Listing Browser",
  "version": "0.3.3",
  "description": "Spreadsheet-style incentive price list with live Walmart listing browsing.",
  "author": "Imran Tursun",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "build": {
    "appId": "com.imrantursun.walmart-listing-browser",
    "productName": "Walmart Listing Browser",
    "copyright": "© 2026 Imran Tursun",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "Walmart Listing Browser"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "uninstallDisplayName": "Walmart Listing Browser",
      "shortcutName": "Walmart Listing Browser"
    }
  }
}
